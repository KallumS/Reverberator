<?xml version="1.0" encoding="utf-8"?>
<!--
  ReaPack index for Reverberator.

  Add this repository in REAPER with Extensions > ReaPack > Import repositories,
  pasting the raw URL of this file on the default branch:

    https://raw.githubusercontent.com/KallumS/Reverberator/main/index.xml

  That URL only resolves once this file is on the default branch.

  Each <source> is pinned to a commit rather than a branch, so an installed
  version is the exact set of files that was tested and cannot change
  underneath anyone. Publishing a new version means adding a <version> block
  with a fresh commit hash - never editing an existing one.

  One package: the JSFX.

  ReaPack keys an installed package by its NAME, so renaming a file is not an
  upgrade. Rename sparingly.
-->
<index version="1" name="Reverberator">
  <category name="Reverb">

    <reapack name="Reverberator.jsfx" type="effect" desc="Reverberator">
      <version name="1.0" author="kallums" time="2026-11-01T14:47:34Z">
        <changelog><![CDATA[First release through ReaPack. A reverb that sends your sound through odd materials instead of a room - chain link fence, ice sheet, tension wire, gong, glass, marble, a wine bottle and more - each a physical model.]]></changelog>
        <source main="main">https://raw.githubusercontent.com/KallumS/Reverberator/497e759419505d1260dd6daabe1d1592847049ce/Reverberator.jsfx</source>
      </version>
      <metadata>
        <description><![CDATA[{\pard Reverberator\par
A reverb that sends your sound through odd materials instead of a room, the way a plate reverb sends it through a sheet of steel.\par
Pick a material and the plug-in plays your audio through a physical model of it.\par
}]]></description>
        <link rel="website">https://github.com/KallumS/Reverberator</link>
      </metadata>
    </reapack>

  </category>
</index>
